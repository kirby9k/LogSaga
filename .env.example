# LogSAGA — environment variables
# Copy to .env and fill in your values. Never commit .env.
#
# Most integration settings (Kodi DB, JSON-RPC, TMDB, MQTT, App) can be
# configured in the web UI at http://<server>:8790/configuration after
# first start. The env vars below remain as a fallback and are auto-imported
# on first startup — existing deployments are not broken.

# ---------------------------------------------------------------------------
# Container / deployment (set these; everything else is optional)
# ---------------------------------------------------------------------------
# Timezone: used by the container OS and as default for Kodi timestamp
# interpretation. Set this to match your Kodi clients' local timezone.
TZ=America/Los_Angeles

# Poll interval (also editable in the Settings UI)
POLL_SECONDS=30

# Storage paths (set by the Docker image; override here for local dev only)
# LOGSAGA_DB_PATH=/config/logsaga.db
# ARTWORK_DIR=/config/artwork

# ---------------------------------------------------------------------------
# Session rules — configure in the Settings UI (/settings)
# ---------------------------------------------------------------------------
# These can also be left as env vars; they are read alongside UI settings.
# MIN_STARTED_SECONDS=120
# SESSION_GAP_HOURS=6
# WATCHED_PERCENT=90
# WATCHED_REMAINING_MINUTES_MOVIE=8
# WATCHED_REMAINING_MINUTES_EPISODE=3

# ---------------------------------------------------------------------------
# Integration settings — configure via the UI (/configuration) instead
# ---------------------------------------------------------------------------
# These env vars still work as a fallback. If set, they are automatically
# imported into the database on first startup and can then be managed in the
# Configuration UI. After migration, changes must be made in the UI.

# Kodi MariaDB connection (read-only account)
# KODI_DB_HOST=YOUR_MARIADB_IP
# KODI_DB_PORT=3306
# KODI_DB_USER=logsaga
# KODI_DB_PASSWORD=your-strong-password
# KODI_DB_NAME=  # leave blank to auto-detect highest MyVideos%

# Kodi JSON-RPC (Kodi-Headless, used for artwork PrepareDownload)
# KODI_JSONRPC_URL=http://YOUR_KODI_HEADLESS_IP:8086/jsonrpc
# KODI_JSONRPC_USER=
# KODI_JSONRPC_PASSWORD=

# TMDB — enables global search + manual watched history from TMDB
# Get a free API key at https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your-tmdb-read-access-token

# MQTT (Home Assistant discovery) — leave HOST blank to disable
# MQTT_HOST=YOUR_MQTT_HOST
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_DISCOVERY_PREFIX=homeassistant

# App
# PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8790
# LOG_LEVEL=INFO
