# LogSAGA — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ---------------------------------------------------------------------------
# Kodi MariaDB connection (read-only account)
# ---------------------------------------------------------------------------
KODI_DB_HOST=YOUR_MARIADB_IP
KODI_DB_PORT=3306
KODI_DB_USER=logsaga
KODI_DB_PASSWORD=your-strong-password

# Optional: pin to a specific DB name. Default: auto-detect highest MyVideos%.
# KODI_DB_NAME=MyVideos131

# ---------------------------------------------------------------------------
# Kodi JSON-RPC (Kodi-Headless, used for artwork PrepareDownload)
# ---------------------------------------------------------------------------
KODI_JSONRPC_URL=http://YOUR_KODI_HEADLESS_IP:8086/jsonrpc
# KODI_JSONRPC_USER=
# KODI_JSONRPC_PASSWORD=

# ---------------------------------------------------------------------------
# Poll interval
# ---------------------------------------------------------------------------
POLL_SECONDS=30

# ---------------------------------------------------------------------------
# Timezone (Kodi writes lastPlayed in client local time; this must match)
# ---------------------------------------------------------------------------
TZ=America/Los_Angeles

# ---------------------------------------------------------------------------
# MQTT (Home Assistant discovery) — leave blank to disable
# ---------------------------------------------------------------------------
# MQTT_HOST=YOUR_MQTT_HOST
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_DISCOVERY_PREFIX=homeassistant

# ---------------------------------------------------------------------------
# TMDB (optional — enables global search + manual watched history from TMDB)
# Get a free API key at https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
# TMDB_API_KEY=your-tmdb-read-access-token

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8790
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Storage paths (Docker sets these via ENV; override here for local dev)
# ---------------------------------------------------------------------------
# LOGSAGA_DB_PATH=/config/logsaga.db
# ARTWORK_DIR=/config/artwork

# ---------------------------------------------------------------------------
# Session rules (confirmed 2026-11-04)
# ---------------------------------------------------------------------------
MIN_STARTED_SECONDS=120
SESSION_GAP_HOURS=6
WATCHED_PERCENT=90
WATCHED_REMAINING_MINUTES_MOVIE=8
WATCHED_REMAINING_MINUTES_EPISODE=3
